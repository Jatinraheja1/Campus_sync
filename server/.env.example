NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/campussync
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
CORS_ORIGIN=http://localhost:5173

# Optional: enables natural-language responses in the role-based CampusSync assistant.
# Timetable optimization and recovery work without an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
